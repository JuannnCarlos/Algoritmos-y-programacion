// Una persona invierte su capital en un banco y desea saber cuanto dinero ganara despues de un mes, si la entidad paga a razo?n del 2  MOD  mensual.
Algoritmo sin_titulo
	Definir capital, ganancia, total Como Real
	Escribir 'solicite el capital para invertir'
	Leer capital
	ganancia <- capital*0.2
	total <- capital+ganancia
	Escribir 'la ganancia despues de un mes es $', ganancia
	Escribir 'el dinero total en la cuenta sera $', total
FinAlgoritmo
