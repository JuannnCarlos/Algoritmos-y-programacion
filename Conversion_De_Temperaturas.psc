//Realizar un algoritmo en pseudoco?digo para convertir grados Celsius a grados Kelvin y Fahrenheit.
Algoritmo de_celsius_a_fahrenheit

	Definir celsius,kelvin,fahrenheit Como Real
	Escribir "ingrese el valor de los grados celsius a convertir:"
	Leer celsius
	fahrenheit=(celsius*(9/5)+32)
	Escribir "el valor de la convercion de grados celsius a fahrenheit es:",fahrenheit
	
	
	kelvin= celsius+273.15
	Escribir "el valor de grados celsius convertido a grados kelvin es:",kelvin
	
	
FinAlgoritmo
